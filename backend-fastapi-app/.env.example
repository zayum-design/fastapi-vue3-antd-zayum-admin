# ============================================
# Zayum Admin 后端环境配置示例
# ============================================
# 复制此文件为 .env 并根据实际环境修改配置值
# ⚠️ 永远不要将真实的 .env 文件提交到 Git！

# ============================================
# 项目基本配置
# ============================================
PROJECT_NAME=Zayum Admin
TIMEZONE=Asia/Shanghai

# 系统路由配置
ARROW_ROUTES=["auth", "captcha", "admin","admin_rule", "plugins","user","general_config","general_category"]

# API 配置
API_ADMIN_STR=/api

# JWT 安全密钥（请使用随机生成的长字符串）
# 生成命令: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# 缓存配置
# ============================================
# 缓存类型: simple（系统内存缓存）或 redis（Redis缓存）
CACHE_TYPE=simple

# Redis 缓存配置（当 CACHE_TYPE=redis 时使用）
REDIS_URL=redis://localhost:6379/0

# ============================================
# 数据库配置
# ============================================
# MySQL 数据库配置
MYSQL_USER=root
MYSQL_PASSWORD=your-database-password
MYSQL_DB=fastapi-vue3-antd-zayum-admin
MYSQL_HOST=localhost
MYSQL_PORT=3306

# PostgreSQL 数据库配置（如使用 PostgreSQL）
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-postgres-password
# POSTGRES_DB=zayum_admin
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ============================================
# 国际化配置
# ============================================
BABEL_DEFAULT_LOCALE=en

# ============================================
# 插件配置
# ============================================
GENERATOR_ENABLED=true

# ============================================
# 文件上传配置
# ============================================
# 最大文件大小（单位：字节，默认 10MB）
MAX_FILE_SIZE=10485760

# 允许的文件扩展名
ALLOWED_EXTENSIONS=["jpg","png","jpeg","gif","txt","pdf","webp"]

# 文件保存目录
UPLOAD_DIR=./uploads

# 插件目录
PLUGINS_DIR=./plugins

# ============================================
# CORS 跨域配置
# ============================================
ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ALLOW_CREDENTIALS=true
ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
ALLOW_HEADERS=["*", "X-Captcha-Id"]
EXPOSE_HEADERS=["X-Captcha-Id"]

# ============================================
# Swagger UI 配置（开发文档）
# ============================================
SWAGGER_CSS_URL=https://cdnjs.cloudflare.com/ajax/libs/swagger-ui/5.9.0/swagger-ui.css
SWAGGER_FAVICON_URL=https://fastapi.tiangolo.com/img/favicon.png
SWAGGER_BUNDLE_JS_URLS=["https://cdnjs.cloudflare.com/ajax/libs/swagger-ui/5.9.0/swagger-ui-bundle.js"]
SWAGGER_PRESET_JS_URLS=["https://cdnjs.cloudflare.com/ajax/libs/swagger-ui/5.9.0/swagger-ui-standalone-preset.js"]
SWAGGER_LOADING_TEXT=正在加载 API 文档...
SWAGGER_ERROR_MESSAGE=无法加载 API 文档资源。请检查网络连接或使用 OpenAPI JSON 文件
