# ============================================
# Zayum Admin Frontend 环境配置示例
# ============================================
# 复制此文件为 .env.development 或 .env.production
# 并根据实际环境修改配置值

# 应用基础配置
# ============================================
# 端口号
VITE_PORT=5666

# 基础路径
VITE_BASE=/

# 应用命名空间
VITE_APP_NAMESPACE=zayum-admin

# 应用版本
VITE_APP_VERSION=1.0.2

# 路由历史模式
# hash: 使用 hash 模式，兼容性好，不需要服务器配置
# history: 使用 HTML5 history 模式，需要服务器配置支持
VITE_ROUTER_HISTORY=history

# API 配置
# ============================================
# Web 地址（前端访问地址）
VITE_GLOB_URL=http://localhost:5666

# 接口地址（后端 API 地址）
VITE_GLOB_API_URL=http://localhost:8000/api

# 开发工具配置
# ============================================
# 是否开启 Nitro Mock 服务
# true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools
# true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true

# 安全配置
# ============================================
# 登录过期时间（单位：小时）
VITE_LOGIN_EXPIRY_HOURS=2

# 生产环境配置示例
# ============================================
VITE_GLOB_URL=https://your-domain.com
VITE_GLOB_API_URL=https://your-domain.com/api

# 备案信息配置

VITE_ICP_NUMBER=京ICP备12345678号-1
VITE_ICP_LINK=https://beian.miit.gov.cn

# 开发环境配置示例
# ============================================
VITE_GLOB_URL=http://localhost:5666
VITE_GLOB_API_URL=http://localhost:8000/api
